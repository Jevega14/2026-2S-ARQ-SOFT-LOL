{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_id",
    "name",
    "ownerId",
    "status",
    "createdAt"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
